            "state" : "translated",
            "value" : "앱을 다시 열면 바뀌어요."
          }
        }
      }
    },
    "앱이 남긴 데이터 %lld곳은 기본으로 남겨요. 삭제할 때 함께 지울 수도 있어요." : {
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "The app's data in %lld location is kept by default. You can delete it along with the app."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "The app's data in %lld locations is kept by default. You can delete it along with the app."
                }
              }
            }
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱이 남긴 데이터 %lld곳은 기본으로 남겨요. 삭제할 때 함께 지울 수도 있어요."
          }
        }
      }
    },
    "앱이 남긴 데이터도 지우기 (%lld곳)" : {
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Also delete the app's data (%lld location)"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Also delete the app's data (%lld locations)"
                }
              }
            }
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱이 남긴 데이터도 지우기 (%lld곳)"
          }
        }
      }
    },
    "앱이 설치한 구성요소(%@)가 있어서 네트워크나 장치 동작이 꼬일 수 있어요. 앱 안의 제거 기능이나 개발사 제거 프로그램을 쓰세요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It installed components (%@) that can break networking or devices if left behind. Use the app's own uninstaller or the developer's removal tool."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱이 설치한 구성요소(%@)가 있어서 네트워크나 장치 동작이 꼬일 수 있어요. 앱 안의 제거 기능이나 개발사 제거 프로그램을 쓰세요."
          }
        }
      }
    },
    "앱이 이미 삭제된 캐시예요" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The app for this cache is already deleted"
