        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱이 이미 삭제된 캐시예요"
          }
        }
      }
    },
    "앱이 필요할 때 다시 만들어요. 처음 열 때 잠깐 느리거나 오프라인 콘텐츠를 다시 받을 수 있어요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The app recreates it when needed. It may open a little slower the first time or download offline content again."
