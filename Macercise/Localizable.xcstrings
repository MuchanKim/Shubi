    "노트처럼 앱 안에 저장한 문서도 함께 지워져요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Documents saved inside the app, like notes, are deleted too."
          }
